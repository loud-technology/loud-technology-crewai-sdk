<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Loud.Technology.CrewAI.Sdk</AssemblyName>
    <RootNamespace>Loud.Technology.CrewAI.Sdk</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Label="NuGet">
    <PackageId>CrewAI</PackageId>
    <Title>CrewAI AMP .NET SDK</Title>
    <Description>Strongly typed .NET SDK for the CrewAI AMP API of a deployed crew or flow, generated from its OpenAPI specification with AutoSDK. Community SDK, not an official CrewAI package.</Description>
    <PackageTags>crewai;crewai-amp;crew;flow;agents;ai;api;client;sdk;dotnet;openapi;autosdk</PackageTags>
    <PackageProjectUrl>https://github.com/loud-technology/loud-technology-crewai-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/loud-technology/loud-technology-crewai-sdk.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
</Project>
